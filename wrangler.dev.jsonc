// Local dev-environment config, used only via explicit `--config` (dev:cf,
// db:migrate:dev). Never read by Nitro's build (which only ever discovers
// `wrangler.jsonc`/`wrangler.json`/`wrangler.toml` by name), and never read by a
// deploy — `deploy`/`deploy:dev` go through scripts/deploy.mjs, which retargets the
// redirected configuration Nitro writes to `.output/server/wrangler.json` using the
// values in scripts/deploy-env.mjs. Config added here has no effect on a deploy.
//
// Kept as a separate flat file rather than a `wrangler.jsonc` `env` block because
// Wrangler rejects `env` blocks in a redirected configuration.
//
// No `vars` here on purpose: this file drives a *local* run, where `.dev.vars` supplies
// the values and overrides config vars anyway. Deployed-origin URLs would be wrong for
// a local run, and are set by scripts/deploy-env.mjs for the environments that need them.
{
  "name": "notex-dev",
  "main": ".output/server/index.mjs",
  // Keep at or after 2025-09-15 (native `node:os`) — see wrangler.jsonc for why.
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notex-dev",
      "database_id": "37577637-6061-4d92-8731-8b9d021c0a51",
      "remote": false,
    },
  ],
}
