// `compatibility_date` must stay at or after 2025-09-15: that is when workerd started
// providing `node:os` natively. Nitro's `cloudflare-module` preset writes
// `.output/server/wrangler.json` with `no_bundle: true`, so `wrangler deploy` skips the
// esbuild pass that would otherwise inject unenv's polyfills — every `node:*` specifier
// in the SSR bundle has to be resolvable by the runtime itself. The bundle imports
// `node:os` (mermaid → @mermaid-js/parser → langium → vscode-jsonrpc), so an older date
// makes the deployed Worker throw `No such module "node:os"` on every request. Keep in
// sync with wrangler.dev.jsonc.
//
// Deploys don't run `wrangler deploy` against this file directly: Nitro reads it at
// build time and emits `.output/server/wrangler.json`, which scripts/deploy.mjs then
// retargets per environment. `vars` are set there (scripts/deploy-env.mjs), not here —
// a bare `wrangler deploy` bypasses that and will strip the Worker's vars, so deploy
// via `bun run deploy` / `bun run deploy:dev`.
{
  "name": "notex",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notex",
      "database_id": "85b25fb8-aa70-46ce-9290-ea414288e99b",
      "remote": false,
    },
  ],
}
