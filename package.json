{
  "name": "notex",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks; command -v bun >/dev/null 2>&1 || { echo 'notex requires bun (see \"packageManager\" in package.json) to build packages/companion — install it from https://bun.sh' >&2; exit 1; }; cd packages/companion && bun run build",
    "dev": "node scripts/dev.mjs",
    "dev:cf": "wrangler dev --config wrangler.dev.jsonc",
    "build": "vite build",
    "deploy": "node scripts/deploy.mjs prod",
    "deploy:dev": "node scripts/deploy.mjs dev",
    "db:migrate:dev": "wrangler d1 migrations apply notex-dev --config wrangler.dev.jsonc --remote",
    "db:migrate:prod": "wrangler d1 migrations apply notex --config wrangler.jsonc --remote",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@better-auth/api-key": "^1.6.29",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-query": "^5.97.0",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@tanstack/react-router-ssr-query": "^1.166.9",
    "@tanstack/react-start": "^1.166.15",
    "@tanstack/router-plugin": "^1.166.13",
    "@uiw/react-md-editor": "^4.1.0",
    "@xyflow/react": "^12.10.2",
    "better-auth": "^1.6.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.12",
    "mermaid": "^11.14.0",
    "nitro": "latest",
    "notex-companion": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^5.1.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "web-vitals": "^5.1.0",
    "wrangler": "^4.81.0"
  }
}
